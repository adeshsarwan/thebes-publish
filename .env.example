# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
LLM_PROVIDER=gemini                 # gemini | mock
GEMINI_DESK_MODEL=gemini-flash-latest
GEMINI_WRITER_MODEL=gemini-flash-latest

# local | production. In production, stories can't be published under placeholder staff profiles.
APP_ENV=local

# PostgreSQL: one database, three schemas (pipeline, newsroom, site), one login per system.
# setup_mac.sh fills these in; on a VPS run:  python -m pipeline.cli db-setup --write-env
ADMIN_DATABASE_URL=postgresql://localhost/storyhub
# PIPELINE_DATABASE_URL=postgresql://fh_pipeline:<generated>@localhost/storyhub
# NEWSROOM_DATABASE_URL=postgresql://fh_newsroom:<generated>@localhost/storyhub
# SITE_DATABASE_URL=postgresql://fh_site:<generated>@localhost/storyhub   <- give ONLY this one to the website

# Newsroom desk. Defaults are right for the Mac. On the server deploy/setup_vps.sh sets
# APP_ENV, DESK_HOSTS, DESK_TRUST_PROXY (read visitor IPs from Cloudflare) and FINANCE_DATA_DIR.
# AUTOPUBLISH_RESPONSIBLE_EDITOR=   (email or slug of the editor named on auto-published stories)
# Public host name so form posts from it are accepted, e.g. DESK_HOSTS=desk.yourdomain.com
# DESK_BIND=127.0.0.1
# DESK_HOSTS=

INGEST_USER_AGENT=FinanceHubBot/0.1 (+https://yourdomain.com/bot; news aggregation)
HTTP_TIMEOUT=20
