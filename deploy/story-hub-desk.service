[Unit]
Description=Story Hub newsroom desk
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=storyhub
Group=storyhub
WorkingDirectory=/opt/story-hub
# settings and database logins come from /opt/story-hub/.env
ExecStart=/opt/story-hub/.venv/bin/python -m newsroom serve --port 8765
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# hardening: the desk only needs its own folders
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/story-hub /var/lib/story-hub

[Install]
WantedBy=multi-user.target
