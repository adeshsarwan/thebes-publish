[Unit]
Description=Finance Hub newsroom desk
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=finhub
Group=finhub
WorkingDirectory=/opt/finance-hub
# settings and database logins come from /opt/finance-hub/.env
ExecStart=/opt/finance-hub/.venv/bin/python -m newsroom serve --port 8765
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# hardening: the desk only needs its own folders
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/finance-hub /var/lib/finance-hub

[Install]
WantedBy=multi-user.target
